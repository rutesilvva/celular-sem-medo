{
  "name": "celular-sem-medo",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export": "expo export --platform all",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "backend:start": "supabase start",
    "backend:stop": "supabase stop",
    "backend:status": "supabase status",
    "backend:reset": "supabase db reset --local",
    "backend:lint": "supabase db lint --local --level warning",
    "backend:migration:new": "supabase migration new",
    "backend:types": "supabase gen types typescript --local > src/types/database.generated.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "expo": "~54.0.36",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "supabase": "2.115.0",
    "typescript": "~5.9.2"
  }
}
