{
  "name": "celular-sem-medo",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:development": "npx eas-cli build --profile development --platform all",
    "build:preview": "npx eas-cli build --profile preview --platform all",
    "build:preview:android": "npx eas-cli build --profile preview --platform android",
    "build:preview:ios": "npx eas-cli build --profile preview --platform ios",
    "build:presentation": "npx eas-cli build --profile presentation --platform all",
    "build:presentation:android": "npx eas-cli build --profile presentation --platform android",
    "build:production": "npx eas-cli build --profile production --platform all",
    "submit:production": "npx eas-cli submit --profile production --platform all",
    "update:preview": "npx eas-cli update --channel preview",
    "update:production": "npx eas-cli update --channel production",
    "release:check": "node scripts/validate-release.mjs",
    "export": "expo export --platform all",
    "audit": "npm audit --audit-level=moderate",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:mission-engine": "jest src/features/mission-engine/executor.test.ts --runInBand",
    "e2e:smoke": "maestro test .maestro/participant-smoke.yaml .maestro/admin-smoke.yaml",
    "e2e:regression": "maestro test .maestro",
    "e2e:presentation": "maestro test .maestro/competition-presentation.yaml",
    "backend:start": "supabase start",
    "backend:stop": "supabase stop",
    "backend:status": "supabase status",
    "backend:reset": "supabase db reset --local",
    "backend:lint": "supabase db lint --local --level warning",
    "backend:test": "supabase test db",
    "backend:test:auth": "node scripts/test-auth-session.mjs",
    "backend:migration:new": "supabase migration new",
    "backend:types": "supabase gen types typescript --local > src/types/database.generated.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.109.0",
    "expo": "~57.0.19",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.4",
    "expo-constants": "~57.0.13",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-linking": "~57.0.9",
    "expo-notifications": "~57.0.16",
    "expo-router": "~57.0.18",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.17",
    "expo-speech": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-qrcode-svg": "^6.3.22",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.5",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "^19.2.3",
    "supabase": "2.115.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "decode-uri-component": "0.5.0",
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
