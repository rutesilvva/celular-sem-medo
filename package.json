{
  "name": "celular-sem-medo",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export": "expo export --platform all",
    "audit": "npm audit --audit-level=moderate",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "backend:start": "supabase start",
    "backend:stop": "supabase stop",
    "backend:status": "supabase status",
    "backend:reset": "supabase db reset --local",
    "backend:lint": "supabase db lint --local --level warning",
    "backend:test": "supabase test db",
    "backend:test:auth": "node scripts/test-auth-session.mjs",
    "backend:migration:new": "supabase migration new",
    "backend:types": "supabase gen types typescript --local > src/types/database.generated.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@supabase/supabase-js": "^2.109.0",
    "expo": "^57.0.9",
    "expo-constants": "~57.0.13",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.15",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.1",
    "supabase": "2.115.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
