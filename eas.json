{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote", "requireCommit": true },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal", "environment": "development", "channel": "development" },
    "development-simulator": { "extends": "development", "ios": { "simulator": true } },
    "preview": { "distribution": "internal", "environment": "preview", "channel": "preview", "autoIncrement": true, "android": { "buildType": "apk" } },
    "presentation": {
      "extends": "preview",
      "channel": "presentation",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_DEMO_MODE": "true",
        "EXPO_PUBLIC_ENABLE_DEVELOPMENT_MOCKS": "false",
        "EXPO_PUBLIC_ENABLE_AI_MISSIONS": "false",
        "EXPO_PUBLIC_OBSERVABILITY_ENABLED": "false"
      }
    },
    "production": { "autoIncrement": true, "environment": "production", "channel": "production" }
  },
  "submit": {
    "production": {}
  }
}
