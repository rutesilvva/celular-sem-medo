# Identifica o ambiente no bundle do aplicativo. Nunca use "production" localmente.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_ENABLE_DEVELOPMENT_MOCKS=false
EXPO_PUBLIC_DEMO_MODE=false
EXPO_PUBLIC_OBSERVABILITY_ENABLED=false
EXPO_PUBLIC_ENABLE_AI_MISSIONS=false
EXPO_PUBLIC_CERTIFICATE_VERIFY_URL=https://<dominio-publico-do-app>

# Valores publicos retornados por `npm run backend:status` depois de iniciar o
# Supabase local. A publishable key pode estar no bundle; a secret key nao.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<copie-a-publishable-key-local>

# OAuth client IDs identificam o app e podem estar no bundle. O fluxo atual usa
# o cliente web via Supabase; os IDs nativos ficam catalogados para os builds.
EXPO_PUBLIC_GOOGLE_AUTH_WEB_CLIENT_ID=<google-web-client-id>
EXPO_PUBLIC_GOOGLE_AUTH_ANDROID_CLIENT_ID=<google-android-client-id>
EXPO_PUBLIC_GOOGLE_AUTH_IOS_CLIENT_ID=<google-ios-client-id>

# Segredos abaixo pertencem somente ao Supabase/CI e nunca são lidos pelo app.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=<google-web-client-id>
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=<google-client-secret>
GEMINI_API_KEY=<configure-com-supabase-secrets-set>

# Usadas apenas pela CLI/CI ao publicar migracoes em projetos remotos.
# Nao use o prefixo EXPO_PUBLIC_ e nao inclua valores reais no Git.
SUPABASE_ACCESS_TOKEN=<supabase-personal-access-token>
SUPABASE_DB_PASSWORD=<senha-do-banco-remoto>
SUPABASE_PROJECT_REF_STAGING=<project-ref-de-staging>
SUPABASE_PROJECT_REF_PRODUCTION=<project-ref-de-production>
